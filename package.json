{
  "name": "claude-svg-optimizer",
  "version": "0.1.0",
  "private": true,
  "description": "Remove redundant styles and C2PA metadata from SVG files downloaded from claude.ai.",
  "type": "module",
  "bin": {
    "claude-svg-optimizer": "dist/cli/index.js"
  },
  "files": [
    "dist/cli"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:web && npm run build:cli",
    "build:web": "vite build",
    "build:cli": "vite build --config vite.cli.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@xmldom/xmldom": "^0.9.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
